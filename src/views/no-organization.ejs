<!DOCTYPE html>
<html lang="en"
    class="h-full text-[var(--color-text-primary)] selection:bg-[color-mix(in_srgb,var(--color-primary)_30%,transparent)] selection:text-[var(--color-primary)] bg-[var(--color-bg-main)]">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96">
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg">
    <link rel="shortcut icon" href="/favicon/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
    <link rel="manifest" href="/favicon/site.webmanifest">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/toast.js"></script>
    <script src="/js/modal.js"></script>
</head>

<body class="min-h-screen flex flex-col text-[var(--color-text-primary)] bg-[var(--color-bg-main)]">

    <%- include('partials/header', { user, orgs: [], currentOrg: null, page: 'no-organization' }) %>

        <main class="flex-1 flex items-center justify-center px-4 py-16">
            <div
                class="max-w-md w-full text-center space-y-6 bg-[color-mix(in_srgb,var(--color-bg-surface)_40%,transparent)] border border-[color-mix(in_srgb,var(--color-border)_70%,transparent)] rounded-3xl p-10 shadow-2xl">
                <div
                    class="w-16 h-16 mx-auto rounded-2xl bg-gradient-to-tr from-[color-mix(in_srgb,var(--color-primary)_20%,transparent)] via-[color-mix(in_srgb,var(--color-secondary)_10%,transparent)] to-[color-mix(in_srgb,var(--color-secondary)_20%,transparent)] border border-[color-mix(in_srgb,var(--color-primary)_30%,transparent)] flex items-center justify-center">
                    <svg class="w-8 h-8 text-[var(--color-primary)]" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                            d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-xl font-black tracking-tight">No Organization Access</h1>
                    <p class="text-sm text-[var(--color-text-secondary)] mt-1.5">You're not a member of this
                        organization yet. Ask an administrator to invite you.</p>
                </div>
            </div>
        </main>

        <footer
            class="border-t border-[var(--color-bg-surface)] py-4 text-center text-xs text-[var(--color-text-muted)]">
            Uptinger &bull; Powered by Emitlogic Technologies Private Limited
        </footer>
</body>

</html>