<!DOCTYPE html>
<html lang="en"
    class="h-full text-[var(--color-text-primary)] selection:bg-[color-mix(in_srgb,var(--color-primary)_30%,transparent)] selection:text-[var(--color-primary)] bg-[var(--color-bg-main)]">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - Uptinger</title>
    <link rel="icon" type="image/png" href="/logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/toast.js"></script>
</head>

<body class="h-full text-[var(--color-text-primary)] bg-[var(--color-bg-main)]">
    <div class="min-h-screen w-full flex items-center justify-center bg-[var(--color-bg-surface)] p-8">
        <div class="max-w-md w-full space-y-8">
            <div class="flex items-center justify-center">
                <img src="/logo.png" alt="Uptinger" class="h-14 w-14">
                <span
                    class="text-2xl font-black tracking-tight bg-gradient-to-r from-white to-[var(--color-primary)] bg-clip-text text-transparent">Uptinger</span>
            </div>

            <div class="text-center">
                <h2 class="text-2xl font-extrabold text-[var(--color-text-primary)]">Set a new password</h2>
                <p class="text-sm text-[var(--color-text-secondary)] mt-2">Choose a strong password for your account.
                </p>
            </div>

            <form id="resetForm" class="space-y-6" onsubmit="handleReset(event)">
                <input type="hidden" id="token" value="<%= token %>">
                <div>
                    <label for="password"
                        class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)] mb-2">New
                        Password</label>
                    <input type="password" id="password" name="password" required minlength="8" placeholder="••••••••"
                        oninput="checkPasswordRequirements()"
                        class="w-full px-4 py-3.5 bg-[var(--color-bg-main)] border border-[var(--color-border)] rounded-xl text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-primary)] focus:ring-1 focus:ring-[var(--color-primary)] transition duration-200 text-sm">
                </div>
                <div>
                    <label for="confirmPassword"
                        class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)] mb-2">Confirm
                        Password</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" required minlength="8"
                        placeholder="••••••••" oninput="checkPasswordRequirements()"
                        class="w-full px-4 py-3.5 bg-[var(--color-bg-main)] border border-[var(--color-border)] rounded-xl text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-primary)] focus:ring-1 focus:ring-[var(--color-primary)] transition duration-200 text-sm">
                </div>

                <div
                    class="p-3.5 bg-[var(--color-bg-main)] border border-[var(--color-bg-surface)] rounded-xl space-y-1 text-xs text-[var(--color-text-secondary)]">
                    <p class="font-medium text-[var(--color-text-secondary)] mb-1">Password Requirements:</p>
                    <div class="grid grid-cols-2 gap-1">
                        <div id="req-length" class="flex items-center space-x-1.5"><i
                                class="fa-solid fa-circle text-[8px] text-[var(--color-text-muted)]"></i><span>At
                                least 8 characters</span></div>
                        <div id="req-upper" class="flex items-center space-x-1.5"><i
                                class="fa-solid fa-circle text-[8px] text-[var(--color-text-muted)]"></i><span>1
                                Uppercase letter</span></div>
                        <div id="req-lower" class="flex items-center space-x-1.5"><i
                                class="fa-solid fa-circle text-[8px] text-[var(--color-text-muted)]"></i><span>1
                                Lowercase letter</span></div>
                        <div id="req-number" class="flex items-center space-x-1.5"><i
                                class="fa-solid fa-circle text-[8px] text-[var(--color-text-muted)]"></i><span>1
                                Number</span></div>
                        <div id="req-special" class="flex items-center space-x-1.5"><i
                                class="fa-solid fa-circle text-[8px] text-[var(--color-text-muted)]"></i><span>1
                                Special character</span></div>
                        <div id="req-match" class="flex items-center space-x-1.5"><i
                                class="fa-solid fa-circle text-[8px] text-[var(--color-text-muted)]"></i><span>Passwords
                                match</span></div>
                    </div>
                </div>

                <button type="submit" id="submitBtn"
                    class="w-full py-3.5 px-4 bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-[var(--color-bg-main)] font-extrabold rounded-xl shadow-lg shadow-[color-mix(in_srgb,var(--color-primary)_25%,transparent)] transition duration-200 flex items-center justify-center space-x-2 disabled:opacity-75 disabled:cursor-not-allowed">
                    <span id="btnText">Reset Password</span>
                    <i id="btnSpinner" class="fa-solid fa-spinner fa-spin text-lg" style="display: none;"></i>
                </button>
            </form>

            <p class="text-center text-sm">
                <a href="/auth/login"
                    class="font-medium text-[var(--color-primary)] hover:text-[var(--color-primary)] transition">Back to
                    sign in</a>
            </p>

            <p class="text-center text-xs text-[var(--color-text-muted)] pt-2">
                Uptinger &bull; Powered by Emitlogic Technologies Private Limited
            </p>
        </div>
    </div>

    <script>
        function checkPasswordRequirements() {
            const pwd = document.getElementById('password').value;
            const confirmPwd = document.getElementById('confirmPassword').value;

            const updateRule = (id, isValid) => {
                const el = document.getElementById(id);
                const icon = el.querySelector('i');
                if (isValid) {
                    el.classList.remove('text-[var(--color-text-secondary)]');
                    el.classList.add('text-[var(--color-primary)]');
                    icon.className = 'fa-solid fa-check text-[var(--color-primary)] text-xs';
                } else {
                    el.classList.remove('text-[var(--color-primary)]');
                    el.classList.add('text-[var(--color-text-secondary)]');
                    icon.className = 'fa-solid fa-circle text-[8px] text-[var(--color-text-muted)]';
                }
            };

            updateRule('req-length', pwd.length >= 8);
            updateRule('req-upper', /[A-Z]/.test(pwd));
            updateRule('req-lower', /[a-z]/.test(pwd));
            updateRule('req-number', /[0-9]/.test(pwd));
            updateRule('req-special', /[@$!%*?&]/.test(pwd));
            updateRule('req-match', pwd.length > 0 && pwd === confirmPwd);
        }

        async function handleReset(event) {
            event.preventDefault();
            const btn = document.getElementById('submitBtn');
            const btnText = document.getElementById('btnText');
            const btnSpinner = document.getElementById('btnSpinner');
            const token = document.getElementById('token').value;
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            if (!token) {
                showToast('This reset link is missing a token. Please request a new one.', 'error');
                return;
            }
            if (password !== confirmPassword) {
                showToast('Passwords do not match.', 'error');
                return;
            }

            const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$/;
            if (!passwordRegex.test(password)) {
                showToast('Password must be at least 8 characters long and include upper, lower, number, and special character.', 'error');
                return;
            }

            btn.disabled = true;
            btnText.textContent = 'Resetting...';
            btnSpinner.style.display = 'inline-block';

            try {
                const response = await fetch('/api/account/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ token, password })
                });
                const result = await response.json();
                showToast(result.message || 'Something went wrong.', result.status ? 'success' : 'error');
                if (result.status) setTimeout(() => window.location.assign('/auth/login'), 1200);
            } catch (error) {
                showToast('A network error occurred. Please try again.', 'error');
            } finally {
                btn.disabled = false;
                btnText.textContent = 'Reset Password';
                btnSpinner.style.display = 'none';
            }
        }
    </script>
</body>

</html>