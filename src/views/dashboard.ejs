        <!-- Client Scripting Engine -->
        <script>
            let monitors = <%- jsonScript(sites) %>;

            function getMonitorIdFromUrl() {
                const raw = new URLSearchParams(window.location.search).get('monitor');
                const id = raw ? parseInt(raw, 10) : NaN;
                return Number.isNaN(id) ? null : id;
            }

            function setMonitorIdInUrl(id) {
                const url = new URL(window.location.href);
                if (id) {
                    url.searchParams.set('monitor', id);
                } else {
                    url.searchParams.delete('monitor');
                }
                history.replaceState(null, '', url);
            }

            const urlMonitorId = getMonitorIdFromUrl();
            let activeId = (urlMonitorId && monitors.find(x => x.id === urlMonitorId))
                ? urlMonitorId
                : (monitors.length > 0 ? monitors[0].id : null);
            let chartInstance = null;
            let uptimePieChartInstance = null;

            const LIVE_REFRESH_INTERVAL_MS = 5000;
            let liveRefreshTimer = null;
            let liveRefreshInFlight = false;

            document.addEventListener('DOMContentLoaded', () => {
                initChart();
                if (activeId) {
                    setMonitorIdInUrl(activeId);
                    highlightActiveCard(!!urlMonitorId);
                    renderActiveMonitor(activeId);
                }
                startLiveRefresh();
                loadTagFilterOptions();
            });

            function loadTagFilterOptions() {
                fetch('/api/tags')
                    .then(r => r.json())
                    .then(res => {
                        if (!res.status || !res.data || !res.data.tags) return;
                        const select = document.getElementById('tagFilter');
                        const current = select.value;
                        select.innerHTML = '<option value="ALL">Tags ▾</option>' +
                            res.data.tags.map(t => `<option value="${t.name}">${t.name}</option>`).join('');
                        if ([...select.options].some(o => o.value === current)) select.value = current;
                    })
                    .catch(() => { });
            }

            function startLiveRefresh() {
                if (liveRefreshTimer) return;
                liveRefreshTimer = setInterval(refreshDashboardData, LIVE_REFRESH_INTERVAL_MS);
            }

            async function refreshDashboardData() {
                if (liveRefreshInFlight) return;
                liveRefreshInFlight = true;
                try {
                    const res = await fetch('/api/monitors/dashboard/live' + location.search, { headers: { 'Accept': 'application/json' } });
                    const json = await res.json();
                    if (!json || !json.status) return;

                    monitors = json.data.sites || [];

                    if (!monitors.find(x => x.id === activeId)) {
                        activeId = monitors.length > 0 ? monitors[0].id : null;
                        setMonitorIdInUrl(activeId);
                    }

                    renderMonitorsList();
                    if (activeId) {
                        renderActiveMonitor(activeId);
                    } else {
                        renderLogsTable();
                    }
                } catch (err) {
                    console.error('Live dashboard refresh failed', err);
                } finally {
                    liveRefreshInFlight = false;
                }
            }

            function buildMonitorCardHTML(site) {
                const hbCellCount = 24;
                const hbList = (site.heartbeats || []).slice(-hbCellCount);
                const hbEmptyCount = Math.max(0, hbCellCount - hbList.length);

                let hbHtml = '';
                for (let i = 0; i < hbEmptyCount; i++) {
                    hbHtml += `<span class="h-4 flex-1 min-w-0 rounded-sm border border-[var(--color-border)] opacity-40"></span>`;
                }
                hbList.forEach(hb => {
                    hbHtml += `<span class="h-4 flex-1 min-w-0 rounded-sm ${hb.status === 'up' ? 'bg-[var(--color-primary)]' : 'bg-[var(--color-error)]'} hover:opacity-80" title="${hb.ping}ms"></span>`;
                });
                hbHtml += `<span class="h-4 flex-1 min-w-0 rounded-sm bg-[var(--color-secondary)] shadow-[0_0_8px_color-mix(in_srgb,var(--color-secondary)_80%,transparent)] animate-pulse" title="Checking..."></span>`;

                const isPaused = site.is_paused;
                const isUp = !isPaused && site.status === 'ONLINE';
                const chipLabel = isPaused ? 'Paused' : (isUp ? 'Up' : 'Down');
                const chipColorVar = isPaused ? '--color-warning' : (isUp ? '--color-primary' : '--color-error');

                return `
                <div onclick="selectMonitor(${site.id})" id="monitor-card-${site.id}"
                    class="monitor-item group cursor-pointer bg-[color-mix(in_srgb,var(--color-bg-main)_40%,transparent)] hover:bg-[color-mix(in_srgb,var(--color-bg-surface)_60%,transparent)] border border-[color-mix(in_srgb,var(--color-border)_70%,transparent)] rounded-xl p-3 transition-all duration-200 relative overflow-hidden">
                    <div class="flex items-center justify-between mb-2">
                        <span class="font-semibold text-sm text-[var(--color-text-primary)] group-hover:text-[var(--color-primary)] transition-colors truncate">${site.name}</span>
                    </div>
                    <div class="flex items-center space-x-1 w-full overflow-hidden">${hbHtml}</div>
                    <div class="flex items-center justify-between mt-2">
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-[color-mix(in_srgb,var(${chipColorVar})_15%,transparent)] text-[var(${chipColorVar})] border border-[color-mix(in_srgb,var(${chipColorVar})_30%,transparent)]">
                            <span class="w-1.5 h-1.5 rounded-full bg-[var(${chipColorVar})]"></span>
                            ${chipLabel}
                        </span>
                        <span class="text-[10px] font-mono text-[var(--color-text-secondary)] uppercase px-1.5 py-0.5 rounded bg-[var(--color-bg-surface)] border border-[var(--color-border)] shrink-0">${site.type}</span>
                    </div>
                </div>`;
            }

            function monitorCardSignature(site) {
                return JSON.stringify({
                    name: site.name,
                    type: site.type,
                    is_paused: site.is_paused,
                    status: site.status,
                    heartbeats: (site.heartbeats || []).slice(-24).map(hb => [hb.status, hb.ping])
                });
            }

            function renderMonitorsList() {
                const container = document.getElementById('monitorsList');
                if (!container) return;

                const existingIds = Array.from(container.children)
                    .map(el => el.id && el.id.replace('monitor-card-', ''))
                    .filter(Boolean)
                    .map(Number);
                const nextIds = monitors.map(s => s.id);
                const sameOrder = existingIds.length === nextIds.length &&
                    existingIds.every((id, i) => id === nextIds[i]);

                if (!sameOrder) {
                    // Structural change (added/removed/reordered) — full rebuild is unavoidable.
                    const preservedScrollTop = container.scrollTop;
                    container.innerHTML = monitors.map(buildMonitorCardHTML).join('');
                    container.scrollTop = preservedScrollTop;
                } else {
                    // Same set/order — only replace cards whose data actually changed,
                    // so unchanged cards keep their DOM node and don't retrigger CSS transitions.
                    monitors.forEach(site => {
                        const el = document.getElementById(`monitor-card-${site.id}`);
                        if (!el) return;
                        const sig = monitorCardSignature(site);
                        if (el.dataset.sig !== sig) {
                            const wrapper = document.createElement('div');
                            wrapper.innerHTML = buildMonitorCardHTML(site);
                            const newEl = wrapper.firstElementChild;
                            newEl.dataset.sig = sig;
                            el.replaceWith(newEl);
                        }
                    });
                }

                document.querySelectorAll('.monitor-item').forEach(el => {
                    if (!el.dataset.sig) {
                        const id = Number(el.id.replace('monitor-card-', ''));
                        const site = monitors.find(s => s.id === id);
                        if (site) el.dataset.sig = monitorCardSignature(site);
                    }
                });

                highlightActiveCard();
                filterMonitors();
            }

            function highlightActiveCard(scrollIntoView) {
                document.querySelectorAll('.monitor-item').forEach(el => {
                    el.classList.remove('border-[var(--color-primary)]', 'bg-[color-mix(in_srgb,var(--color-bg-surface)_60%,transparent)]', 'shadow-[inset_0_0_0_1px_var(--color-primary)]');
                });
                const activeCard = document.getElementById(`monitor-card-${activeId}`);
                if (activeCard) {
                    activeCard.classList.add('border-[var(--color-primary)]', 'bg-[color-mix(in_srgb,var(--color-bg-surface)_60%,transparent)]', 'shadow-[inset_0_0_0_1px_var(--color-primary)]');
                    if (scrollIntoView) {
                        // Scroll only the sidebar list container, not any ancestor (main content/window) —
                        // scrollIntoView() walks up every scrollable ancestor, which drags the main scroll
                        // along whenever the card isn't already vertically centered in the viewport.
                        const listContainer = document.getElementById('monitorsList');
                        if (listContainer) {
                            const targetTop = activeCard.offsetTop - (listContainer.clientHeight / 2) + (activeCard.clientHeight / 2);
                            listContainer.scrollTo({ top: targetTop, behavior: 'smooth' });
                        }
                    }
                }
            }

            function onTypeChange() {
                const type = document.getElementById('formType').value;
                document.querySelectorAll('.dynamic-panel').forEach(el => el.classList.add('hidden'));

                if (['http', 'http-keyword', 'http-json-query', 'browser', 'websocket'].includes(type)) {
                    document.getElementById('panelUrl').classList.remove('hidden');
                    document.getElementById('panelHttpOptions').classList.remove('hidden');
                    if (type === 'http-keyword' || type === 'http-json-query') {
                        document.getElementById('panelKeyword').classList.remove('hidden');
                    }
                } else if (type === 'dns') {
                    document.getElementById('panelHostPort').classList.remove('hidden');
                    document.getElementById('panelDns').classList.remove('hidden');
                    document.getElementById('hostLabel').innerText = 'Domain / Hostname';
                    document.getElementById('formPort').value = 53;
                } else if (['postgres', 'mysql', 'mongodb', 'redis', 'mssql', 'oracle'].includes(type)) {
                    document.getElementById('panelHostPort').classList.remove('hidden');
                    document.getElementById('panelDb').classList.remove('hidden');
                    document.getElementById('hostLabel').innerText = 'Database Host / IP';
                    document.getElementById('formPort').value = type === 'postgres' ? 5432 : type === 'mysql' ? 3306 : type === 'redis' ? 6379 : 1433;
                } else if (['tcp', 'ping', 'smtp', 'mqtt', 'rabbitmq', 'kafka', 'gamedig', 'steam'].includes(type)) {
                    document.getElementById('panelHostPort').classList.remove('hidden');
                    document.getElementById('hostLabel').innerText = 'Hostname / IP';
                    document.getElementById('formPort').value = type === 'smtp' ? 25 : type === 'mqtt' ? 1883 : 80;
                } else {
                    document.getElementById('panelUrl').classList.remove('hidden');
                }
            }

            function themeColor(name) {
                return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
            }

            function initChart() {
                const canvas = document.getElementById('responseChart');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                const primary = themeColor('--color-primary');
                const border = themeColor('--color-border');
                const bgSurface = themeColor('--color-bg-surface');
                const bgMain = themeColor('--color-bg-main');
                const textSecondary = themeColor('--color-text-secondary');
                const textMuted = themeColor('--color-text-muted');

                const gradient = ctx.createLinearGradient(0, 0, 0, 240);
                gradient.addColorStop(0, `color-mix(in srgb, ${primary} 35%, transparent)`);
                gradient.addColorStop(1, `color-mix(in srgb, ${primary} 0%, transparent)`);

                chartInstance = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: [],
                        datasets: [{
                            label: 'Avg Ping',
                            data: [],
                            borderColor: primary,
                            borderWidth: 2.5,
                            pointBackgroundColor: primary,
                            pointBorderColor: bgMain,
                            pointRadius: 4,
                            tension: 0.35,
                            fill: true,
                            backgroundColor: gradient
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: bgSurface,
                                titleColor: textSecondary,
                                bodyColor: primary,
                                borderColor: border,
                                borderWidth: 1,
                                padding: 10,
                                displayColors: false,
                                callbacks: {
                                    label: context => `Latency: ${context.raw} ms`
                                }
                            }
                        },
                        scales: {
                            x: { grid: { color: `color-mix(in srgb, ${border} 50%, transparent)` }, ticks: { color: textMuted, font: { family: 'JetBrains Mono', size: 10 } } },
                            y: { grid: { color: `color-mix(in srgb, ${border} 50%, transparent)` }, ticks: { color: textMuted, font: { family: 'JetBrains Mono', size: 10 }, callback: v => v + ' ms' } }
                        }
                    }
                });

                initUptimePieChart();
            }

            const centerTextPlugin = {
                id: 'centerText',
                afterDraw(chart) {
                    if (chart.config.type !== 'doughnut' || !chart.config._centerText) return;
                    const { ctx, chartArea: { left, right, top, bottom } } = chart;
                    const centerX = (left + right) / 2;
                    const centerY = (top + bottom) / 2;
                    const { value, label, valueColor, labelColor } = chart.config._centerText;

                    ctx.save();
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';

                    ctx.font = '700 22px Inter, sans-serif';
                    ctx.fillStyle = valueColor;
                    ctx.fillText(value, centerX, centerY - 10);

                    ctx.font = '600 10px Inter, sans-serif';
                    ctx.fillStyle = labelColor;
                    ctx.fillText(label, centerX, centerY + 12);
                    ctx.restore();
                }
            };

            function initUptimePieChart() {
                const canvas = document.getElementById('uptimePieChart');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                const primary = themeColor('--color-primary');
                const error = themeColor('--color-error');
                const bgSurface = themeColor('--color-bg-surface');
                const textSecondary = themeColor('--color-text-secondary');
                const textPrimary = themeColor('--color-text-primary');
                const border = themeColor('--color-border');

                uptimePieChartInstance = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Uptime', 'Downtime'],
                        datasets: [{
                            data: [100, 0],
                            backgroundColor: [primary, error],
                            borderColor: border,
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '85%',
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: bgSurface,
                                titleColor: textSecondary,
                                bodyColor: primary,
                                borderColor: border,
                                borderWidth: 1,
                                padding: 10,
                                callbacks: {
                                    label: context => `${context.label}: ${context.raw.toFixed(2)}%`
                                }
                            }
                        }
                    },
                    plugins: [centerTextPlugin]
                });

                uptimePieChartInstance.config._centerText = {
                    value: '100%',
                    label: 'UPTIME',
                    valueColor: textPrimary,
                    labelColor: textSecondary
                };
                uptimePieChartInstance.update();
            }

            function updateUptimePieChart(m) {
                if (!uptimePieChartInstance) return;

                let upCount = 0;
                let downCount = 0;
                if (m.heartbeats && m.heartbeats.length > 0) {
                    m.heartbeats.forEach(hb => hb.status === 'up' ? upCount++ : downCount++);
                }

                let uptimePct;
                let downtimePct;
                if (upCount + downCount > 0) {
                    uptimePct = (upCount / (upCount + downCount)) * 100;
                    downtimePct = 100 - uptimePct;
                } else {
                    uptimePct = parseFloat(m.uptime_24h) || 100;
                    downtimePct = 100 - uptimePct;
                }

                uptimePieChartInstance.data.datasets[0].data = [uptimePct, downtimePct];
                uptimePieChartInstance.config._centerText.value = `${uptimePct.toFixed(1)}%`;
                uptimePieChartInstance.update('none');

                const upEl = document.getElementById('pieUptimeValue');
                const downEl = document.getElementById('pieDowntimeValue');
                if (upEl) upEl.innerText = `${uptimePct.toFixed(2)}%`;
                if (downEl) downEl.innerText = `${downtimePct.toFixed(2)}%`;
            }

            // ---- VPS Performance panel (type === 'vps') ----
            let vpsChartInstance = null;
            let vpsCpuChartInstance = null;
            let vpsRamChartInstance = null;
            let vpsStorageChartInstance = null;
            let vpsRequestToken = 0;

            // Small doughnut "gauge" shared by the CPU/RAM/Storage cards — same
            // cutout/centerText treatment as the Uptime vs Downtime pie chart, just
            // a single used/remaining slice pair instead of up/down.
            function initVpsGaugeChart(canvasId, color) {
                const canvas = document.getElementById(canvasId);
                if (!canvas) return null;
                const ctx = canvas.getContext('2d');
                const trackColor = themeColor('--color-border');
                const bgSurface = themeColor('--color-bg-surface');
                const textSecondary = themeColor('--color-text-secondary');
                const textPrimary = themeColor('--color-text-primary');

                const chart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Used', 'Free'],
                        datasets: [{
                            data: [0, 100],
                            backgroundColor: [themeColor(color), `color-mix(in srgb, ${trackColor} 60%, transparent)`],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '78%',
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: bgSurface, titleColor: textSecondary, bodyColor: textPrimary,
                                borderColor: trackColor, borderWidth: 1, padding: 8,
                                callbacks: { label: context => `${context.label}: ${context.raw.toFixed(1)}%` }
                            }
                        }
                    },
                    plugins: [centerTextPlugin]
                });
                chart.config._centerText = { value: '0%', label: '', valueColor: textPrimary, labelColor: textSecondary };
                return chart;
            }

            function updateVpsGaugeChart(chart, pct, label) {
                if (!chart) return;
                const clamped = Math.max(0, Math.min(100, pct));
                chart.data.datasets[0].data = [clamped, 100 - clamped];
                chart.config._centerText.value = `${Math.round(clamped)}%`;
                chart.config._centerText.label = label;
                chart.update('none');
            }

            function initVpsChart() {
                const canvas = document.getElementById('vpsHistoryChart');
                if (!canvas || vpsChartInstance) return;
                const ctx = canvas.getContext('2d');
                const primary = themeColor('--color-primary');
                const secondary = themeColor('--color-secondary');
                const border = themeColor('--color-border');
                const bgSurface = themeColor('--color-bg-surface');
                const textSecondary = themeColor('--color-text-secondary');
                const textMuted = themeColor('--color-text-muted');

                vpsChartInstance = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: [],
                        datasets: [
                            { label: 'CPU %', data: [], borderColor: primary, backgroundColor: 'transparent', borderWidth: 2, pointRadius: 0, tension: 0.3 },
                            { label: 'RAM %', data: [], borderColor: secondary, backgroundColor: 'transparent', borderWidth: 2, pointRadius: 0, tension: 0.3 }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: { display: true, labels: { color: textSecondary, font: { size: 10 } } },
                            tooltip: {
                                backgroundColor: bgSurface, titleColor: textSecondary, borderColor: border, borderWidth: 1, padding: 10,
                                callbacks: { label: context => `${context.dataset.label}: ${context.raw}%` }
                            }
                        },
                        scales: {
                            x: { grid: { color: `color-mix(in srgb, ${border} 50%, transparent)` }, ticks: { color: textMuted, font: { family: 'JetBrains Mono', size: 10 } } },
                            y: { min: 0, max: 100, grid: { color: `color-mix(in srgb, ${border} 50%, transparent)` }, ticks: { stepSize: 10, color: textMuted, font: { family: 'JetBrains Mono', size: 10 }, callback: v => v + '%' } }
                        }
                    }
                });
            }

            function formatMb(mb) {
                if (mb == null) return 'N/A';
                return mb >= 1024 ? `${(mb / 1024).toFixed(1)} GB` : `${Math.round(mb)} MB`;
            }

            function formatBytesRate(bytes) {
                if (bytes == null) return 'N/A';
                if (bytes >= 1024 * 1024 * 1024) return `${(bytes / 1024 / 1024 / 1024).toFixed(2)} GB`;
                if (bytes >= 1024 * 1024) return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
                if (bytes >= 1024) return `${(bytes / 1024).toFixed(1)} KB`;
                return `${bytes} B`;
            }

            function formatUptime(seconds) {
                if (seconds == null) return 'N/A';
                const days = Math.floor(seconds / 86400);
                const hours = Math.floor((seconds % 86400) / 3600);
                if (days > 0) return `${days}d ${hours}h`;
                const mins = Math.floor((seconds % 3600) / 60);
                return `${hours}h ${mins}m`;
            }

            function pctBarColor(pct) {
                if (pct >= 90) return '--color-error';
                if (pct >= 75) return '--color-warning';
                return '--color-primary';
            }

            function fetchAndRenderVpsMetrics(m) {
                const token = ++vpsRequestToken;
                fetch(`/api/monitors/${m.id}/vps-metrics?range=1h`)
                    .then(r => r.json())
                    .then(res => {
                        if (token !== vpsRequestToken || activeId !== m.id) return; // superseded
                        const metrics = (res.status && res.data && res.data.metrics) ? res.data.metrics : [];
                        renderVpsPerformance(metrics);
                    })
                    .catch(() => { });
            }

            function renderVpsPerformance(metrics) {
                // No empty-state placeholder — with no metrics yet, `latest` is just an
                // empty object and every gauge/chart below renders at its zero state
                // instead of a "waiting for agent" message.
                const latest = metrics.length > 0 ? metrics[metrics.length - 1] : {};

                document.getElementById('vpsLastSeen').innerText = latest.timestamp
                    ? `Last report: ${new Date(latest.timestamp).toLocaleTimeString()}`
                    : 'Waiting for agent…';

                if (!vpsCpuChartInstance) vpsCpuChartInstance = initVpsGaugeChart('vpsCpuChart', '--color-primary');
                if (!vpsRamChartInstance) vpsRamChartInstance = initVpsGaugeChart('vpsRamChart', '--color-secondary');
                if (!vpsStorageChartInstance) vpsStorageChartInstance = initVpsGaugeChart('vpsStorageChart', '--color-warning');

                const cpuPct = latest.cpu_pct || 0;
                updateVpsGaugeChart(vpsCpuChartInstance, cpuPct, 'CPU');
                document.getElementById('vpsLoadText').innerText = `Load: ${(latest.load1 ?? 0).toFixed(2)}, ${(latest.load5 ?? 0).toFixed(2)}, ${(latest.load15 ?? 0).toFixed(2)}`;

                const ramTotal = latest.ram_total_mb || 0;
                const ramPct = ramTotal > 0 ? (latest.ram_used_mb / ramTotal) * 100 : 0;
                updateVpsGaugeChart(vpsRamChartInstance, ramPct, 'RAM');
                document.getElementById('vpsSwapText').innerText = `${formatMb(latest.ram_used_mb)} / ${formatMb(latest.ram_total_mb)}`
                    + (latest.swap_total_mb ? ` · Swap ${formatMb(latest.swap_used_mb)}/${formatMb(latest.swap_total_mb)}` : '');

                document.getElementById('vpsUptimeText').innerText = formatUptime(latest.uptime_seconds);
                document.getElementById('vpsNetText').innerText = `↓ ${formatBytesRate(latest.net_rx_bytes)}  ↑ ${formatBytesRate(latest.net_tx_bytes)}`;

                // Primary disk (root, or the first reported mount) drives the Storage
                // gauge card; any remaining mounts are listed below it.
                const disks = Array.isArray(latest.disks) ? latest.disks : [];
                const primaryDisk = disks.find(d => d.mount === '/') || disks[0];
                const storageLabel = document.getElementById('vpsStorageLabel');
                if (primaryDisk) {
                    const storagePct = primaryDisk.total_mb > 0 ? (primaryDisk.used_mb / primaryDisk.total_mb) * 100 : 0;
                    updateVpsGaugeChart(vpsStorageChartInstance, storagePct, 'DISK');
                    storageLabel.innerText = disks.length > 1 ? `Storage (${primaryDisk.mount})` : 'Storage';
                    document.getElementById('vpsStorageText').innerText = `${formatMb(primaryDisk.used_mb)} / ${formatMb(primaryDisk.total_mb)}`;
                } else {
                    updateVpsGaugeChart(vpsStorageChartInstance, 0, 'DISK');
                    storageLabel.innerText = 'Storage';
                    document.getElementById('vpsStorageText').innerText = 'No disk data reported.';
                }

                const otherDisks = primaryDisk ? disks.filter(d => d !== primaryDisk) : [];
                const disksExtra = document.getElementById('vpsDisksExtra');
                const disksContainer = document.getElementById('vpsDisksList');
                disksExtra.classList.toggle('hidden', otherDisks.length === 0);
                disksContainer.innerHTML = '';
                otherDisks.forEach(d => {
                    const pct = d.total_mb > 0 ? Math.round((d.used_mb / d.total_mb) * 100) : 0;
                    const row = document.createElement('div');
                    row.innerHTML = `
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-xs font-mono text-[var(--color-text-secondary)]">${escapeHtml(d.mount)}</span>
                            <span class="text-xs font-mono text-[var(--color-text-primary)]">${formatMb(d.used_mb)} / ${formatMb(d.total_mb)} (${pct}%)</span>
                        </div>
                        <div class="h-2 rounded-full bg-[var(--color-bg-main)] border border-[var(--color-border)] overflow-hidden">
                            <div class="h-full rounded-full bg-[var(${pctBarColor(pct)})]" style="width:${Math.min(100, pct)}%"></div>
                        </div>`;
                    disksContainer.appendChild(row);
                });

                const hasNginx = latest.nginx_active_connections != null;
                document.getElementById('vpsNginxNotDetected').classList.toggle('hidden', hasNginx);
                document.getElementById('vpsNginxCards').classList.toggle('hidden', !hasNginx);
                if (hasNginx) {
                    document.getElementById('vpsNginxActive').innerText = latest.nginx_active_connections;
                    document.getElementById('vpsNginxRequests').innerText = latest.nginx_requests_total ?? 'N/A';
                    document.getElementById('vpsNginxErrorSize').innerText = formatBytesRate(latest.nginx_error_log_size_bytes);
                    document.getElementById('vpsNginxAccessSize').innerText = formatBytesRate(latest.nginx_access_log_size_bytes);

                    const errors = Array.isArray(latest.nginx_recent_errors) ? latest.nginx_recent_errors : [];
                    document.getElementById('vpsNginxErrors').innerHTML = errors.length > 0
                        ? errors.map(line => `<div class="whitespace-pre">${escapeHtml(line)}</div>`).join('')
                        : '<div class="text-[var(--color-text-muted)]">No recent errors.</div>';

                    const accessLines = Array.isArray(latest.nginx_recent_access) ? latest.nginx_recent_access : [];
                    document.getElementById('vpsNginxAccess').innerHTML = accessLines.length > 0
                        ? accessLines.map(line => `<div class="whitespace-pre">${escapeHtml(line)}</div>`).join('')
                        : '<div class="text-[var(--color-text-muted)]">No recent access log lines.</div>';
                }

                initVpsChart();
                if (vpsChartInstance) {
                    vpsChartInstance.data.labels = metrics.map(mt => formatLocalTime(mt.timestamp));
                    vpsChartInstance.data.datasets[0].data = metrics.map(mt => Math.round(mt.cpu_pct || 0));
                    vpsChartInstance.data.datasets[1].data = metrics.map(mt => mt.ram_total_mb > 0 ? Math.round((mt.ram_used_mb / mt.ram_total_mb) * 100) : 0);
                    vpsChartInstance.update('none');
                }
            }

            function showVpsInstallModal() {
                const m = monitors.find(x => x.id === activeId);
                if (!m) return;
                fetch(`/api/monitors/${m.id}/agent-install`)
                    .then(r => r.json())
                    .then(res => {
                        if (!res.status || !res.data || !res.data.docker_run) {
                            showToast(res.message || 'Failed to load install command', 'error');
                            return;
                        }

                        const tabs = [
                            { key: 'run', label: 'docker run', content: res.data.docker_run },
                            { key: 'compose', label: 'docker compose', content: res.data.docker_compose_install }
                        ];
                        let activeTab = 'run';

                        const overlay = document.createElement('div');
                        overlay.style.cssText = 'position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,0.55);display:flex;align-items:center;justify-content:center;padding:1rem;';
                        const card = document.createElement('div');
                        card.style.cssText = 'width:100%;max-width:42rem;background:var(--color-bg-surface);border:1px solid color-mix(in srgb, var(--color-border) 80%, transparent);border-radius:1rem;box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);padding:1.5rem;max-height:90vh;overflow:auto;';
                        card.innerHTML = `
                            <h3 style="font-size:1rem;font-weight:800;color:var(--color-text-primary);margin:0 0 0.75rem">Agent install command</h3>
                            ${res.data.warning ? `<p style="font-size:0.8125rem;line-height:1.5;margin:0 0 1rem;padding:0.75rem;border-radius:0.5rem;background:color-mix(in srgb, var(--color-error) 12%, transparent);border:1px solid color-mix(in srgb, var(--color-error) 30%, transparent);color:var(--color-error);font-weight:600">${res.data.warning}</p>` : ''}
                            <div data-tabs style="display:flex;gap:0.375rem;margin:0 0 0.75rem"></div>
                            <p data-tab-hint style="font-size:0.75rem;color:var(--color-text-muted);margin:0 0 0.5rem"></p>
                            <pre style="white-space:pre-wrap;word-break:break-all;background:var(--color-bg-main);border:1px solid color-mix(in srgb, var(--color-border) 70%, transparent);border-radius:0.5rem;padding:0.875rem;font-family:'JetBrains Mono',monospace;font-size:0.75rem;color:var(--color-text-primary);margin:0 0 1rem;max-height:16rem;overflow:auto"></pre>
                            <details style="margin:0 0 1rem">
                                <summary style="cursor:pointer;font-size:0.8125rem;font-weight:700;color:var(--color-text-secondary)">Nginx stub_status config (only needed if you want Nginx stats)</summary>
                                <p style="font-size:0.75rem;color:var(--color-text-muted);margin:0.5rem 0">Add this <code>server</code> block inside Nginx's <code>http {}</code> block, then reload Nginx. Don't publish this port in any compose <code>ports:</code> — leaving it unpublished keeps it reachable only from containers on the same Docker network as this agent.</p>
                                <pre style="white-space:pre-wrap;word-break:break-all;background:var(--color-bg-main);border:1px solid color-mix(in srgb, var(--color-border) 70%, transparent);border-radius:0.5rem;padding:0.875rem;font-family:'JetBrains Mono',monospace;font-size:0.75rem;color:var(--color-text-primary);margin:0;max-height:12rem;overflow:auto"></pre>
                            </details>
                            <div style="display:flex;justify-content:space-between;gap:0.5rem">
                                <button type="button" data-regen style="padding:0.5rem 1rem;border-radius:0.5rem;font-size:0.8125rem;font-weight:700;background:transparent;color:var(--color-error);border:1px solid color-mix(in srgb, var(--color-error) 40%, transparent);cursor:pointer">Regenerate Token</button>
                                <div style="display:flex;gap:0.5rem">
                                    <button type="button" data-copy style="padding:0.5rem 1rem;border-radius:0.5rem;font-size:0.8125rem;font-weight:700;background:transparent;color:var(--color-text-secondary);border:1px solid color-mix(in srgb, var(--color-border) 70%, transparent);cursor:pointer">Copy</button>
                                    <button type="button" data-close style="padding:0.5rem 1rem;border-radius:0.5rem;font-size:0.8125rem;font-weight:700;border:none;cursor:pointer;color:var(--color-bg-main);background:var(--color-primary)">Close</button>
                                </div>
                            </div>
                        `;

                        const tabsWrap = card.querySelector('[data-tabs]');
                        const pre = card.querySelector('pre');
                        const hint = card.querySelector('[data-tab-hint]');
                        const nginxPre = card.querySelectorAll('pre')[1];
                        nginxPre.textContent = res.data.nginx_stub_status_snippet || '';

                        function renderTab() {
                            const tab = tabs.find(t => t.key === activeTab);
                            pre.textContent = tab.content;
                            hint.textContent = activeTab === 'compose'
                                ? 'Writes docker-compose.yml alongside the agent source, then `docker compose up -d --build`. Stop it later with `docker compose down` from the same directory.'
                                : 'One-shot `docker run` — stop/remove it later with `docker stop uptinger-agent && docker rm uptinger-agent`.';
                            Array.from(tabsWrap.children).forEach(btn => {
                                const isActive = btn.dataset.key === activeTab;
                                btn.style.background = isActive ? 'var(--color-primary)' : 'transparent';
                                btn.style.color = isActive ? 'var(--color-bg-main)' : 'var(--color-text-secondary)';
                                btn.style.border = isActive ? 'none' : '1px solid color-mix(in srgb, var(--color-border) 70%, transparent)';
                            });
                        }
                        tabs.forEach(t => {
                            const btn = document.createElement('button');
                            btn.type = 'button';
                            btn.dataset.key = t.key;
                            btn.textContent = t.label;
                            btn.style.cssText = 'padding:0.375rem 0.75rem;border-radius:0.5rem;font-size:0.75rem;font-weight:700;cursor:pointer';
                            btn.addEventListener('click', () => { activeTab = t.key; renderTab(); });
                            tabsWrap.appendChild(btn);
                        });
                        renderTab();

                        overlay.appendChild(card);
                        document.body.appendChild(overlay);

                        const close = () => overlay.remove();
                        overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
                        card.querySelector('[data-close]').addEventListener('click', close);
                        card.querySelector('[data-copy]').addEventListener('click', () => {
                            navigator.clipboard.writeText(tabs.find(t => t.key === activeTab).content).then(() => showToast('Copied to clipboard', 'success'));
                        });
                        card.querySelector('[data-regen]').addEventListener('click', async () => {
                            const ok = await openConfirmModal({
                                title: 'Regenerate agent token?',
                                message: 'The old token stops working immediately. You will need to reinstall the agent on the VPS with the new command.',
                                confirmLabel: 'Regenerate',
                                danger: true
                            });
                            if (!ok) return;
                            fetch(`/api/monitors/${m.id}/agent-token/regenerate`, { method: 'POST' })
                                .then(r => r.json())
                                .then(() => { close(); showVpsInstallModal(); });
                        });
                    })
                    .catch(() => showToast('Failed to load install command', 'error'));
            }

            function selectMonitor(id) {
                activeId = id;
                setMonitorIdInUrl(id);
                highlightActiveCard(true);
                renderActiveMonitor(id);
            }

            function renderActiveMonitor(id) {
                const m = monitors.find(x => x.id === id);
                if (!m) return;

                const nameEl = document.getElementById('activeName');
                if (nameEl) nameEl.innerText = m.name;
                const idEl = document.getElementById('activeId');
                if (idEl) idEl.innerText = `#${m.id}`;
                const badgeEl = document.getElementById('activeTypeBadge');
                if (badgeEl) badgeEl.innerText = (m.type || 'http').toUpperCase();

                const urlEl = document.getElementById('activeUrl');
                if (urlEl) urlEl.href = m.url || '#';
                const urlTextEl = document.getElementById('activeUrlText');
                if (urlTextEl) urlTextEl.innerText = m.url || m.hostname || 'Configured Target';

                const minStr = Math.round((m.interval_seconds || 60) / 60);
                const intervalEl = document.getElementById('activeIntervalText');
                if (intervalEl) intervalEl.innerText = `Check every ${m.interval_seconds || 60} seconds (${minStr} minute${minStr > 1 ? 's' : ''})`;

                const bigBadge = document.getElementById('bigStatusBadge');
                const pauseBtn = document.getElementById('pauseBtnText');
                if (bigBadge && pauseBtn) {
                    if (m.is_paused) {
                        bigBadge.innerText = 'Paused';
                        bigBadge.className = 'px-8 py-3 rounded-full bg-[var(--color-warning)] text-[var(--color-bg-main)] font-black text-2xl tracking-wide shadow-lg shadow-[color-mix(in_srgb,var(--color-warning)_30%,transparent)] flex items-center justify-center';
                        pauseBtn.innerText = 'Resume';
                    } else if (m.status === 'ONLINE') {
                        bigBadge.innerText = 'Up';
                        bigBadge.className = 'px-8 py-3 rounded-full bg-[var(--color-primary)] text-[var(--color-bg-main)] font-black text-2xl tracking-wide shadow-lg shadow-[color-mix(in_srgb,var(--color-primary)_30%,transparent)] flex items-center justify-center';
                        pauseBtn.innerText = 'Pause';
                    } else {
                        bigBadge.innerText = 'Down';
                        bigBadge.className = 'px-8 py-3 rounded-full bg-[var(--color-error)] text-[var(--color-text-primary)] font-black text-2xl tracking-wide shadow-lg shadow-[color-mix(in_srgb,var(--color-error)_30%,transparent)] flex items-center justify-center';
                        pauseBtn.innerText = 'Pause';
                    }
                }

                if (document.getElementById('metricCurrent')) document.getElementById('metricCurrent').innerText = m.current_response || 'N/A';
                if (document.getElementById('metricAvg24h')) document.getElementById('metricAvg24h').innerText = m.avg_response_24h || 'N/A';
                if (document.getElementById('metricUptime24h')) document.getElementById('metricUptime24h').innerText = m.uptime_24h || '100%';
                if (document.getElementById('metricUptime30d')) document.getElementById('metricUptime30d').innerText = m.uptime_30d || '100%';
                if (document.getElementById('metricUptime1y')) document.getElementById('metricUptime1y').innerText = m.uptime_1y || '100%';

                if (['http', 'browser'].includes(m.type)) {
                    if (document.getElementById('metricCertSub')) document.getElementById('metricCertSub').innerText = `( ${m.cert_exp_date || 'N/A'} )`;
                    if (document.getElementById('metricCertDays')) document.getElementById('metricCertDays').innerText = m.cert_exp_days || 'N/A';
                    if (document.getElementById('metricDomainSub')) document.getElementById('metricDomainSub').innerText = `( ${m.domain_exp_date || 'N/A'} )`;
                    if (document.getElementById('metricDomainDays')) document.getElementById('metricDomainDays').innerText = m.domain_exp_days || 'N/A';
                } else {
                    if (document.getElementById('metricCertSub')) document.getElementById('metricCertSub').innerText = '( Non-SSL )';
                    if (document.getElementById('metricCertDays')) document.getElementById('metricCertDays').innerText = 'N/A';
                    if (document.getElementById('metricDomainSub')) document.getElementById('metricDomainSub').innerText = '( N/A )';
                    if (document.getElementById('metricDomainDays')) document.getElementById('metricDomainDays').innerText = 'N/A';
                }

                const hbBarContainer = document.getElementById('activeHeartbeatBar');
                if (hbBarContainer) {
                    hbBarContainer.innerHTML = '';

                    const hbCellCount = 48;
                    const hbList = (m.heartbeats || []).slice(-hbCellCount);
                    const hbEmptyCount = Math.max(0, hbCellCount - hbList.length);

                    for (let i = 0; i < hbEmptyCount; i++) {
                        const cell = document.createElement('span');
                        cell.className = 'h-9 flex-1 min-w-0 rounded-md border border-[var(--color-border)] opacity-40';
                        hbBarContainer.appendChild(cell);
                    }

                    hbList.forEach(hb => {
                        const span = document.createElement('span');
                        span.className = `h-9 flex-1 min-w-0 rounded-md ${hb.status === 'up' ? 'bg-[var(--color-primary)]' : 'bg-[var(--color-error)]'} hover:opacity-80 transition-all cursor-pointer`;
                        span.title = `Ping: ${hb.ping}ms (${formatLocalTime(hb.timestamp) || hb.time})`;
                        hbBarContainer.appendChild(span);
                    });

                    const pingIndicator = document.createElement('span');
                    pingIndicator.className = 'h-9 flex-1 min-w-0 rounded-md bg-[var(--color-secondary)] shadow-[0_0_8px_color-mix(in_srgb,var(--color-secondary)_80%,transparent)] animate-pulse';
                    pingIndicator.title = 'Checking...';
                    hbBarContainer.appendChild(pingIndicator);
                }

                renderLogsTable();

                const isVps = m.type === 'vps';
                const vpsCard = document.getElementById('vpsPerformanceCard');
                const httpCard = document.getElementById('httpMetricsCard');
                const chartRow = document.getElementById('responseChartRow');
                if (vpsCard) vpsCard.classList.toggle('hidden', !isVps);
                if (httpCard) httpCard.classList.toggle('hidden', isVps);
                if (chartRow) chartRow.classList.toggle('hidden', isVps);

                if (isVps) {
                    fetchAndRenderVpsMetrics(m);
                } else {
                    updateResponseChart(m);
                    updateUptimePieChart(m);
                }
            }

            // The server sends `time` pre-formatted in UTC ("HH:MM"), which doesn't match the
            // Logs table's display (built client-side via `new Date(...).toLocaleString()`, i.e.
            // the browser's local timezone). Recompute from the raw UTC `timestamp` here so chart
            // labels / tooltips line up with what the Logs table shows.
            function formatLocalTime(timestamp) {
                if (!timestamp) return null;
                const d = new Date(timestamp);
                if (Number.isNaN(d.getTime())) return null;
                return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            }

            // Not cached: the dashboard live-polls every 5s (LIVE_REFRESH_INTERVAL_MS), so a
            // cached response would go stale almost immediately and mask incoming checks.
            async function getChartHeartbeats(m, range) {
                if (range === 'Recent') return m.heartbeats || [];

                try {
                    const res = await fetch(`/api/monitors/${m.id}/heartbeats?range=${range}`);
                    const json = await res.json();
                    return (json.status && json.data && json.data.heartbeats) ? json.data.heartbeats : [];
                } catch {
                    return m.heartbeats || [];
                }
            }

            // Guards against a slow fetch resolving after the user has already switched monitor
            // or range, which would otherwise paint stale data over the current selection.
            let chartRequestToken = 0;

            async function updateResponseChart(m) {
                if (!chartInstance || !m || !m.heartbeats || m.heartbeats.length === 0) return;

                const filterEl = document.getElementById('chartTimeFilter');
                const range = filterEl ? filterEl.value : 'Recent';

                const token = ++chartRequestToken;
                const filtered = await getChartHeartbeats(m, range);
                if (token !== chartRequestToken || activeId !== m.id) return; // superseded by a newer request

                const lastHb = m.heartbeats[m.heartbeats.length - 1];
                const isDown = lastHb ? lastHb.status !== 'up' : (m.status !== 'ONLINE');
                const lineColorVar = isDown ? '--color-error' : '--color-primary';
                const lineColor = themeColor(lineColorVar);
                const ctx = chartInstance.ctx;
                const gradient = ctx.createLinearGradient(0, 0, 0, 240);
                gradient.addColorStop(0, `color-mix(in srgb, ${lineColor} 35%, transparent)`);
                gradient.addColorStop(1, `color-mix(in srgb, ${lineColor} 0%, transparent)`);

                chartInstance.data.labels = filtered.map(h => formatLocalTime(h.timestamp) || h.time);
                chartInstance.data.datasets[0].data = filtered.map(h => h.ping);
                chartInstance.data.datasets[0].borderColor = lineColor;
                chartInstance.data.datasets[0].pointBackgroundColor = lineColor;
                chartInstance.data.datasets[0].pointHoverBackgroundColor = lineColor;
                chartInstance.data.datasets[0].backgroundColor = gradient;
                chartInstance.update();

                const legendDot = document.getElementById('chartLegendDot');
                if (legendDot) {
                    legendDot.className = `w-3 h-3 rounded bg-[var(${lineColorVar})] inline-block shadow-[0_0_8px_color-mix(in_srgb,var(${lineColorVar})_80%,transparent)]`;
                }
            }

            function escapeHtml(str) {
                return String(str).replace(/[&<>"']/g, c => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
                }[c]));
            }

            function formatResponseHeaders(raw, logId) {
                if (!raw) return '<span class="text-[var(--color-text-muted)]">—</span>';
                let obj;
                try { obj = JSON.parse(raw); } catch { return '<span class="text-[var(--color-text-muted)]">—</span>'; }
                const summary = Object.entries(obj).map(([k, v]) => `${k}: ${v}`).join('; ');
                return `
                    <div class="flex items-center gap-1.5">
                        <span class="cursor-help truncate" title="${escapeHtml(summary)}">${escapeHtml(summary)}</span>
                        <button type="button" onclick="copyResponseHeaders(${logId}, this)" title="Copy response"
                            class="shrink-0 p-1 rounded-md hover:bg-[var(--color-bg-surface)] text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                            </svg>
                        </button>
                    </div>
                `;
            }

            function copyResponseHeaders(logId, btn) {
                const m = monitors.find(x => x.id === activeId);
                const log = m && m.logs ? m.logs.find(l => l.id === logId) : null;
                if (!log || !log.response_headers) return;

                let text = log.response_headers;
                try { text = JSON.stringify(JSON.parse(log.response_headers), null, 2); } catch { /* copy raw as-is */ }

                const done = () => {
                    showToast('Response copied to clipboard', 'success');
                    if (btn) {
                        const original = btn.innerHTML;
                        btn.innerHTML = `<svg class="w-3.5 h-3.5 text-[var(--color-success)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>`;
                        setTimeout(() => { btn.innerHTML = original; }, 1200);
                    }
                };

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(text).then(done).catch(() => {
                        showToast('Failed to copy response', 'error');
                    });
                } else {
                    const ta = document.createElement('textarea');
                    ta.value = text;
                    ta.style.position = 'fixed';
                    ta.style.opacity = '0';
                    document.body.appendChild(ta);
                    ta.select();
                    try { document.execCommand('copy'); done(); } catch { showToast('Failed to copy response', 'error'); }
                    document.body.removeChild(ta);
                }
            }

            function getFilteredLogs() {
                const m = monitors.find(x => x.id === activeId);
                const limitEl = document.getElementById('logsLimitFilter');
                const limit = limitEl ? parseInt(limitEl.value, 10) : 20;
                const statusEl = document.getElementById('logsStatusFilter');
                const statusFilter = statusEl ? statusEl.value : 'ALL';
                const dateEl = document.getElementById('logsDateFilter');
                const dateFilter = dateEl ? dateEl.value : '';

                let logs = (m && m.logs ? m.logs : []);
                if (statusFilter !== 'ALL') {
                    logs = logs.filter(log => log.status === statusFilter);
                }
                if (dateFilter) {
                    logs = logs.filter(log => log.timestamp && log.timestamp.slice(0, 10) === dateFilter);
                }
                return logs.slice(0, limit);
            }

            function renderLogsTable() {
                const tbody = document.getElementById('logsTableBody');
                if (!tbody) return;

                tbody.innerHTML = '';
                const logs = getFilteredLogs();

                if (logs.length > 0) {
                    logs.forEach(log => {
                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-[color-mix(in_srgb,var(--color-bg-surface)_30%,transparent)] transition-colors';
                        const isError = log.status === 'ERROR';
                        const badgeClass = isError
                            ? 'bg-[color-mix(in_srgb,var(--color-error)_20%,transparent)] text-[var(--color-error)] border border-[color-mix(in_srgb,var(--color-error)_30%,transparent)]'
                            : 'bg-[color-mix(in_srgb,var(--color-primary)_20%,transparent)] text-[var(--color-primary)] border border-[color-mix(in_srgb,var(--color-primary)_30%,transparent)]';
                        tr.innerHTML = `
                        <td class="py-2.5 px-4 text-[var(--color-text-secondary)]">${log.timestamp ? new Date(log.timestamp).toLocaleString() : ''}</td>
                        <td class="py-2.5 px-4"><span class="px-2 py-0.5 rounded text-[10px] font-bold ${badgeClass}">${log.status}</span></td>
                        <td class="py-2.5 px-4 text-[var(--color-text-primary)]">${log.ms} ms</td>
                        <td class="py-2.5 px-4 text-[var(--color-text-secondary)] truncate max-w-xs">${log.msg}</td>
                        <td class="py-2.5 px-4 text-[var(--color-text-secondary)] max-w-xs">${formatResponseHeaders(log.response_headers, log.id)}</td>
                    `;
                        tbody.appendChild(tr);
                    });
                } else {
                    tbody.innerHTML = `<tr><td colspan="5" class="py-4 text-center text-[var(--color-text-muted)]">No heartbeat check events recorded.</td></tr>`;
                }
            }

            function togglePauseActive() {
                const m = monitors.find(x => x.id === activeId);
                if (!m) return;
                fetch(`/api/monitors/${m.id}/pause`, { method: 'POST' })
                    .then(r => r.json())
                    .then(res => {
                        m.is_paused = !m.is_paused;
                        openToast(m.is_paused ? `Paused ${m.name}` : `Resumed ${m.name}`);
                        renderActiveMonitor(activeId);
                    });
            }

            function editActive() {
                const m = monitors.find(x => x.id === activeId);
                if (!m) return;
                window.location.href = `/monitors/${m.id}/edit`;
            }

            function cloneActive() {
                const m = monitors.find(x => x.id === activeId);
                if (!m) return;
                const payload = {
                    name: `${m.name} (Copy)`,
                    type: m.type,
                    url: m.url,
                    hostname: m.hostname,
                    port: m.port,
                    interval_seconds: m.interval_seconds,
                    tags: m.tags
                };

                fetch('/api/monitors', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                }).then(r => r.json()).then(res => {
                    if (res.success) {
                        openToast(`Cloned monitor: ${payload.name}`);
                        setTimeout(() => location.reload(), 800);
                    } else {
                        showToast(res.message || 'Failed to clone monitor', 'error');
                    }
                });
            }

            function deleteActive() {
                const m = monitors.find(x => x.id === activeId);
                if (!m) return;
                document.getElementById('deleteConfirmName').innerText = m.name;
                const modal = document.getElementById('deleteConfirmModal');
                const container = document.getElementById('deleteConfirmContainer');
                modal.classList.remove('hidden');
                setTimeout(() => container.classList.remove('scale-95', 'opacity-0'), 10);
            }

            function closeDeleteConfirmModal() {
                const modal = document.getElementById('deleteConfirmModal');
                const container = document.getElementById('deleteConfirmContainer');
                container.classList.add('scale-95', 'opacity-0');
                setTimeout(() => modal.classList.add('hidden'), 200);
            }

            function confirmDeleteActive() {
                fetch(`/api/monitors/${activeId}`, { method: 'DELETE' })
                    .then(r => r.json())
                    .then(res => {
                        closeDeleteConfirmModal();
                        openToast('Monitor deleted');
                        location.reload();
                    });
            }

            function resetActive() {
                const m = monitors.find(x => x.id === activeId);
                if (!m) return;
                document.getElementById('resetConfirmName').innerText = m.name;
                const modal = document.getElementById('resetConfirmModal');
                const container = document.getElementById('resetConfirmContainer');
                modal.classList.remove('hidden');
                setTimeout(() => container.classList.remove('scale-95', 'opacity-0'), 10);
            }

            function closeResetConfirmModal() {
                const modal = document.getElementById('resetConfirmModal');
                const container = document.getElementById('resetConfirmContainer');
                container.classList.add('scale-95', 'opacity-0');
                setTimeout(() => modal.classList.add('hidden'), 200);
            }

            function confirmResetActive() {
                fetch(`/api/monitors/${activeId}/reset`, { method: 'POST' })
                    .then(r => r.json())
                    .then(res => {
                        closeResetConfirmModal();
                        openToast('Monitor data reset');
                        location.reload();
                    });
            }

            function filterMonitors() {
                const status = document.getElementById('statusFilter').value;
                const tag = document.getElementById('tagFilter').value;

                monitors.forEach(m => {
                    const card = document.getElementById(`monitor-card-${m.id}`);
                    if (!card) return;

                    const matchStatus = status === 'ALL' || (status === 'PAUSED' && m.is_paused) || (m.status === status && !m.is_paused);
                    const matchTag = tag === 'ALL' || (m.tags && m.tags.includes(tag));

                    card.style.display = (matchStatus && matchTag) ? 'block' : 'none';
                });
            }

            function openToast(msg) {
                showToast(msg, 'success');
            }

            function updateChartFilter() {
                const m = monitors.find(x => x.id === activeId);
                if (!m) return;
                updateResponseChart(m);
            }

            async function handleLogout(event) {
                if (event) event.preventDefault();
                try {
                    await fetch('/api/account/logout', { method: 'POST' });
                } catch (err) {
                    console.error('Logout request failed', err);
                }
                window.location.href = '/auth/login';
            }
        </script>
</body>

</html>