<!DOCTYPE html>
<html lang="en"
    class="h-full text-[var(--color-text-primary)] selection:bg-[color-mix(in_srgb,var(--color-primary)_30%,transparent)] selection:text-[var(--color-primary)] bg-[var(--color-bg-main)]">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96">
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg">
    <link rel="shortcut icon" href="/favicon/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
    <link rel="manifest" href="/favicon/site.webmanifest">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/toast.js"></script>
    <script src="/js/modal.js"></script>

</head>

<body class="min-h-screen flex flex-col text-[var(--color-text-primary)] bg-[var(--color-bg-main)]">

    <%- include('partials/header', { user, orgs: (typeof orgs !=='undefined' ? orgs : []), currentOrg: (typeof
        currentOrg !=='undefined' ? currentOrg : null), page: 'dashboard' }) %>

        <!-- Main Dashboard Grid -->
        <main class="flex-1 max-w-[1700px] w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

            <% if (sites.length===0) { %>
                <!-- FULL SCREEN BEAUTIFUL EMPTY STATE -->
                <div
                    class="py-16 flex flex-col items-center justify-center text-center space-y-6 bg-[color-mix(in_srgb,var(--color-bg-surface)_40%,transparent)] border border-[color-mix(in_srgb,var(--color-border)_70%,transparent)] rounded-3xl p-12 shadow-2xl max-w-3xl mx-auto my-8">
                    <div class="relative">
                        <div
                            class="w-24 h-24 rounded-3xl bg-gradient-to-tr from-[color-mix(in_srgb,var(--color-primary)_20%,transparent)] via-[color-mix(in_srgb,var(--color-secondary)_10%,transparent)] to-[color-mix(in_srgb,var(--color-secondary)_20%,transparent)] border border-[color-mix(in_srgb,var(--color-primary)_30%,transparent)] flex items-center justify-center shadow-[0_0_40px_color-mix(in_srgb,var(--color-primary)_15%,transparent)]">
                            <svg class="w-12 h-12 text-[var(--color-primary)]" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <span
                            class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-[var(--color-primary)] border-4 border-[var(--color-bg-main)] animate-pulse"></span>
                    </div>

                    <div class="max-w-md space-y-2">
                        <h2 class="text-2xl font-black text-center text-[var(--color-text-primary)] tracking-tight">No
                            Monitors
                            Configured <span class="text-[var(--color-primary)]">Yet</span></h2>
                        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
                            Welcome to Uptinger! Get started by adding your first endpoint or service to monitor its
                            uptime,
                            SSL certificates, and response times in real time.
                        </p>
                    </div>

                    <div class="pt-2">
                        <a href="/monitors/new"
                            class="px-8 py-3.5 rounded-2xl bg-[var(--color-primary)] hover:bg-[var(--color-primary)] text-[var(--color-bg-main)] font-black text-sm tracking-wide shadow-xl shadow-[color-mix(in_srgb,var(--color-primary)_25%,transparent)] transition-all duration-200 flex items-center space-x-2.5 active:scale-95">
                            <svg class="w-5 h-5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                            </svg>
                            <span>Add Your First Monitor</span>
                        </a>
                    </div>
                </div>
                <% } else { %>
                    <!-- DASHBOARD GRID WHEN MONITORS EXIST -->
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

                        <!-- LEFT SIDEBAR COLUMN: Monitors List Card -->
                        <aside class="lg:col-span-4 xl:col-span-3 space-y-4">
                            <div
                                class="bg-[color-mix(in_srgb,var(--color-bg-surface)_60%,transparent)] border border-[color-mix(in_srgb,var(--color-border)_80%,transparent)] rounded-2xl p-4 shadow-xl space-y-4">

                                <!-- Filter Controls -->
                                <div class="space-y-2">
                                    <div class="grid grid-cols-2 gap-2">
                                        <div class="relative">
                                            <select id="statusFilter" onchange="filterMonitors()"
                                                class="w-full appearance-none bg-[color-mix(in_srgb,var(--color-bg-main)_80%,transparent)] border border-[var(--color-border)] rounded-xl px-3 py-1.5 pr-7 text-xs font-medium text-[var(--color-text-secondary)] focus:outline-none focus:border-[color-mix(in_srgb,var(--color-primary)_50%,transparent)] cursor-pointer">
                                                <option value="ALL">Status ▾</option>
                                                <option value="ONLINE">Up</option>
                                                <option value="OFFLINE">Down</option>
                                                <option value="PAUSED">Paused</option>
                                            </select>
                                            <svg class="w-3.5 h-3.5 text-[var(--color-text-secondary)] absolute right-2.5 top-2.5 pointer-events-none"
                                                fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M19 9l-7 7-7-7" />
                                            </svg>
                                        </div>
                                        <div class="relative">
                                            <select id="tagFilter" onchange="filterMonitors()"
                                                class="w-full appearance-none bg-[color-mix(in_srgb,var(--color-bg-main)_80%,transparent)] border border-[var(--color-border)] rounded-xl px-3 py-1.5 pr-7 text-xs font-medium text-[var(--color-text-secondary)] focus:outline-none focus:border-[color-mix(in_srgb,var(--color-primary)_50%,transparent)] cursor-pointer">
                                                <option value="ALL">Tags ▾</option>
                                            </select>
                                            <svg class="w-3.5 h-3.5 text-[var(--color-text-secondary)] absolute right-2.5 top-2.5 pointer-events-none"
                                                fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M19 9l-7 7-7-7" />
                                            </svg>
                                        </div>
                                    </div>
                                </div>

                                <!-- Monitors List -->
                                <div id="monitorsList" class="space-y-2 max-h-[calc(100vh-190px)] overflow-y-auto pr-1">
                                    <% sites.forEach((site, index)=> { %>
                                        <% const isPaused=site.is_paused; const isUp=!isPaused && site.status==='ONLINE'
                                            ; const chipLabel=isPaused ? 'Paused' : (isUp ? 'Up' : 'Down' ); const
                                            chipColorVar=isPaused ? '--color-warning' : (isUp ? '--color-primary'
                                            : '--color-error' ); %>
                                            <div onclick="selectMonitor(<%= site.id %>)"
                                                id="monitor-card-<%= site.id %>"
                                                class="monitor-item group cursor-pointer bg-[color-mix(in_srgb,var(--color-bg-main)_40%,transparent)] hover:bg-[color-mix(in_srgb,var(--color-bg-surface)_60%,transparent)] border border-[color-mix(in_srgb,var(--color-border)_70%,transparent)] rounded-xl p-3 transition-all duration-200 relative overflow-hidden <%= index === 0 ? 'border-[var(--color-primary)] bg-[color-mix(in_srgb,var(--color-bg-surface)_60%,transparent)] shadow-[inset_0_0_0_1px_var(--color-primary)]' : '' %>">

                                                <div class="flex items-center justify-between mb-2">
                                                    <span
                                                        class="font-semibold text-sm text-[var(--color-text-primary)] group-hover:text-[var(--color-primary)] transition-colors truncate">
                                                        <%= site.name %>
                                                    </span>
                                                </div>

                                                <!-- Dynamic Heartbeat Bar Visualization: fixed grid of cells, filled from the right, pending indicator at the right end -->
                                                <div class="flex items-center space-x-1 w-full overflow-hidden">
                                                    <% const hbCellCount=24; const hbList=(site.heartbeats ||
                                                        []).slice(-hbCellCount); const hbEmptyCount=Math.max(0,
                                                        hbCellCount - hbList.length); %>
                                                        <% for (let i=0; i < hbEmptyCount; i++) { %>
                                                            <span
                                                                class="h-4 flex-1 min-w-0 rounded-sm border border-[var(--color-border)] opacity-40"></span>
                                                            <% } %>
                                                                <% hbList.forEach(hb=> { %>
                                                                    <span
                                                                        class="h-4 flex-1 min-w-0 rounded-sm <%= hb.status === 'up' ? 'bg-[var(--color-primary)]' : 'bg-[var(--color-error)]' %> hover:opacity-80"
                                                                        title="<%= hb.ping %>ms"></span>
                                                                    <% }); %>
                                                                        <span
                                                                            class="h-4 flex-1 min-w-0 rounded-sm bg-[var(--color-secondary)] shadow-[0_0_8px_color-mix(in_srgb,var(--color-secondary)_80%,transparent)] animate-pulse"
                                                                            title="Checking..."></span>
                                                </div>

                                                <div class="flex items-center justify-between mt-2">
                                                    <span
                                                        class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-[color-mix(in_srgb,var(<%= chipColorVar %>)_15%,transparent)] text-[var(<%= chipColorVar %>)] border border-[color-mix(in_srgb,var(<%= chipColorVar %>)_30%,transparent)]">
                                                        <span
                                                            class="w-1.5 h-1.5 rounded-full bg-[var(<%= chipColorVar %>)]"></span>
                                                        <%= chipLabel %>
                                                    </span>
                                                    <span
                                                        class="text-[10px] font-mono text-[var(--color-text-secondary)] uppercase px-1.5 py-0.5 rounded bg-[var(--color-bg-surface)] border border-[var(--color-border)] shrink-0">
                                                        <%= site.type %>
                                                    </span>
                                                </div>
                                            </div>
                                            <% }); %>
                                </div>

                            </div>
                        </aside>

                        <!-- RIGHT MAIN COLUMN: Card-Based Dashboard Details Pane -->
                        <section class="lg:col-span-8 xl:col-span-9 space-y-6">

                            <!-- Active Monitor Header Card -->
                            <div
                                class="bg-[color-mix(in_srgb,var(--color-bg-surface)_60%,transparent)] border border-[color-mix(in_srgb,var(--color-border)_80%,transparent)] rounded-2xl p-6 shadow-xl space-y-6">
                                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                                    <div>
                                        <div class="flex items-baseline space-x-2">
                                            <h1 id="activeName"
                                                class="text-3xl font-extrabold text-[var(--color-text-primary)] tracking-tight">
                                                -
                                            </h1>
                                            <span id="activeId"
                                                class="text-sm font-semibold text-[var(--color-text-muted)]">#0</span>
                                            <span id="activeTypeBadge"
                                                class="text-xs font-mono font-semibold px-2 py-0.5 rounded-full bg-[var(--color-bg-surface)] text-[var(--color-primary)] border border-[var(--color-border)] uppercase">
                                                -
                                            </span>
                                        </div>
                                        <a id="activeUrl" href="#" target="_blank" rel="noopener noreferrer"
                                            class="inline-flex items-center text-sm font-medium text-[var(--color-primary)] hover:text-[var(--color-primary)] underline underline-offset-4 mt-1 space-x-1">
                                            <span id="activeUrlText">-</span>
                                            <svg class="w-4 h-4 inline" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                            </svg>
                                        </a>
                                    </div>

                                    <div class="shrink-0">
                                        <div id="bigStatusBadge"
                                            class="px-8 py-3 rounded-full bg-[var(--color-primary)] text-[var(--color-bg-main)] font-black text-2xl tracking-wide shadow-lg shadow-[color-mix(in_srgb,var(--color-primary)_30%,transparent)] flex items-center justify-center">
                                            Up
                                        </div>
                                    </div>
                                </div>

                                <!-- Heartbeat Sequence -->
                                <div class="pt-2 space-y-2">
                                    <div id="activeHeartbeatBar"
                                        class="flex items-center space-x-1 w-full overflow-hidden py-1">
                                    </div>
                                    <p id="activeIntervalText"
                                        class="text-xs text-[var(--color-text-secondary)] font-medium">Check every 60
                                        seconds</p>
                                </div>
                            </div>

                            <!-- VPS PERFORMANCE CARD (shown only for 'vps' type monitors) -->
                            <div id="vpsPerformanceCard" class="hidden space-y-5">
                                <div class="flex items-center justify-between flex-wrap gap-3">
                                    <h2 class="text-base font-bold text-[var(--color-text-primary)] flex items-center gap-2">
                                        <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                                        </svg>
                                        <span>VPS Performance</span>
                                    </h2>
                                    <div class="flex items-center gap-2">
                                        <span id="vpsLastSeen" class="text-[11px] font-mono text-[var(--color-text-muted)]"></span>
                                        <button type="button" onclick="showVpsInstallModal()"
                                            class="text-xs font-bold px-3 py-1.5 rounded-lg bg-[var(--color-bg-main)] border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:text-[var(--color-primary)] hover:border-[var(--color-primary)] transition-colors">
                                            Agent Install Command
                                        </button>
                                    </div>
                                </div>

                                <div id="vpsMetricsBody" class="space-y-5">
                                        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
                                            <!-- CPU pie card -->
                                            <div class="bg-[color-mix(in_srgb,var(--color-bg-surface)_60%,transparent)] border border-[color-mix(in_srgb,var(--color-border)_80%,transparent)] rounded-2xl p-5 shadow-xl flex flex-col items-center text-center space-y-3">
                                                <div class="flex items-center space-x-2 self-start">
                                                    <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-primary)] inline-block shadow-[0_0_8px_color-mix(in_srgb,var(--color-primary)_80%,transparent)]"></span>
                                                    <h4 class="text-xs font-bold text-[var(--color-text-secondary)] uppercase tracking-wide">CPU</h4>
                                                </div>
                                                <div class="relative h-28 w-28">
                                                    <canvas id="vpsCpuChart"></canvas>
                                                </div>
                                                <p id="vpsLoadText" class="text-[10px] text-[var(--color-text-muted)] font-mono"></p>
                                            </div>
                                            <!-- RAM pie card -->
                                            <div class="bg-[color-mix(in_srgb,var(--color-bg-surface)_60%,transparent)] border border-[color-mix(in_srgb,var(--color-border)_80%,transparent)] rounded-2xl p-5 shadow-xl flex flex-col items-center text-center space-y-3">
                                                <div class="flex items-center space-x-2 self-start">
                                                    <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-secondary)] inline-block shadow-[0_0_8px_color-mix(in_srgb,var(--color-secondary)_80%,transparent)]"></span>
                                                    <h4 class="text-xs font-bold text-[var(--color-text-secondary)] uppercase tracking-wide">RAM</h4>
                                                </div>
                                                <div class="relative h-28 w-28">
                                                    <canvas id="vpsRamChart"></canvas>
                                                </div>
                                                <p id="vpsSwapText" class="text-[10px] text-[var(--color-text-muted)] font-mono"></p>
                                            </div>
                                            <!-- Storage pie card -->
                                            <div class="bg-[color-mix(in_srgb,var(--color-bg-surface)_60%,transparent)] border border-[color-mix(in_srgb,var(--color-border)_80%,transparent)] rounded-2xl p-5 shadow-xl flex flex-col items-center text-center space-y-3">
                                                <div class="flex items-center space-x-2 self-start">
                                                    <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-warning)] inline-block shadow-[0_0_8px_color-mix(in_srgb,var(--color-warning)_80%,transparent)]"></span>
                                                    <h4 class="text-xs font-bold text-[var(--color-text-secondary)] uppercase tracking-wide" id="vpsStorageLabel">Storage</h4>
                                                </div>
                                                <div class="relative h-28 w-28">
                                                    <canvas id="vpsStorageChart"></canvas>
                                                </div>
                                                <p id="vpsStorageText" class="text-[10px] text-[var(--color-text-muted)] font-mono"></p>
                                            </div>
                                            <!-- Uptime / network stat card -->
                                            <div class="bg-[color-mix(in_srgb,var(--color-bg-surface)_60%,transparent)] border border-[color-mix(in_srgb,var(--color-border)_80%,transparent)] rounded-2xl p-5 shadow-xl flex flex-col items-center justify-center text-center space-y-3">
                                                <div class="flex items-center space-x-2 self-start">
                                                    <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-text-secondary)] inline-block"></span>
                                                    <h4 class="text-xs font-bold text-[var(--color-text-secondary)] uppercase tracking-wide">Uptime</h4>
                                                </div>
                                                <div class="h-28 w-full flex items-center justify-center">
                                                    <span id="vpsUptimeText" class="text-3xl font-black text-[var(--color-text-primary)] font-mono">-</span>
                                                </div>
                                                <p id="vpsNetText" class="text-[10px] text-[var(--color-text-muted)] font-mono"></p>
                                            </div>
                                        </div>

                                        <div id="vpsDisksExtra" class="hidden">
                                            <h4 class="text-xs font-bold text-[var(--color-text-secondary)] uppercase tracking-wide mb-2">Other Mounts</h4>
                                            <div id="vpsDisksList" class="space-y-3"></div>
                                        </div>

                                        <!-- CPU & RAM history card -->
                                        <div class="bg-[color-mix(in_srgb,var(--color-bg-surface)_60%,transparent)] border border-[color-mix(in_srgb,var(--color-border)_80%,transparent)] rounded-2xl p-5 shadow-xl">
                                            <h4 class="text-xs font-bold text-[var(--color-text-secondary)] uppercase tracking-wide mb-2">Performance History</h4>
                                            <div class="relative h-72 w-full pt-2">
                                                <canvas id="vpsHistoryChart"></canvas>
                                            </div>
                                        </div>

                                        <!-- Nginx: error.log / access.log cards -->
                                        <div id="vpsNginxNotDetected" class="hidden text-xs text-[var(--color-text-muted)]">Nginx not detected on this host (or stub_status isn't enabled).</div>
                                        <div id="vpsNginxCards" class="hidden grid grid-cols-1 lg:grid-cols-2 gap-4">
                                            <div class="bg-[color-mix(in_srgb,var(--color-bg-surface)_60%,transparent)] border border-[color-mix(in_srgb,var(--color-border)_80%,transparent)] rounded-2xl p-5 shadow-xl space-y-3">
                                                <div class="flex items-center justify-between">
                                                    <div class="flex items-center space-x-2">
                                                        <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-error)] inline-block shadow-[0_0_8px_color-mix(in_srgb,var(--color-error)_80%,transparent)]"></span>
                                                        <h5 class="text-xs font-bold text-[var(--color-text-secondary)] uppercase tracking-wide">Nginx Error Log</h5>
                                                    </div>
                                                    <span class="text-[10px] text-[var(--color-text-muted)] font-mono">Active: <span id="vpsNginxActive" class="text-[var(--color-text-primary)] font-bold">-</span> · Size: <span id="vpsNginxErrorSize" class="text-[var(--color-text-primary)] font-bold">-</span></span>
                                                </div>
                                                <div id="vpsNginxErrors"
                                                    class="max-h-48 overflow-y-auto overflow-x-auto text-[11px] font-mono text-[var(--color-error)] bg-[var(--color-bg-main)] border border-[var(--color-border)] rounded-xl p-3 space-y-1"></div>
                                            </div>
                                            <div class="bg-[color-mix(in_srgb,var(--color-bg-surface)_60%,transparent)] border border-[color-mix(in_srgb,var(--color-border)_80%,transparent)] rounded-2xl p-5 shadow-xl space-y-3">
                                                <div class="flex items-center justify-between">
                                                    <div class="flex items-center space-x-2">
                                                        <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-primary)] inline-block shadow-[0_0_8px_color-mix(in_srgb,var(--color-primary)_80%,transparent)]"></span>
                                                        <h5 class="text-xs font-bold text-[var(--color-text-secondary)] uppercase tracking-wide">Nginx Access Log</h5>
                                                    </div>
                                                    <span class="text-[10px] text-[var(--color-text-muted)] font-mono">Requests: <span id="vpsNginxRequests" class="text-[var(--color-text-primary)] font-bold">-</span> · Size: <span id="vpsNginxAccessSize" class="text-[var(--color-text-primary)] font-bold">-</span></span>
                                                </div>
                                                <div id="vpsNginxAccess"
                                                    class="max-h-48 overflow-y-auto overflow-x-auto text-[11px] font-mono text-[var(--color-text-secondary)] bg-[var(--color-bg-main)] border border-[var(--color-border)] rounded-xl p-3 space-y-1"></div>
                                            </div>
                                        </div>
                                </div>
                            </div>
                            <!-- KEY METRICS GRID CARD -->
                            <div id="httpMetricsCard"
                                class="bg-[color-mix(in_srgb,var(--color-bg-surface)_60%,transparent)] border border-[color-mix(in_srgb,var(--color-border)_80%,transparent)] rounded-2xl p-6 shadow-xl">
                                <div
                                    class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-4 text-center divide-x-0 sm:divide-x divide-[color-mix(in_srgb,var(--color-bg-surface)_80%,transparent)]">
                                    <div class="p-2 space-y-1">
                                        <div class="text-xs font-semibold text-[var(--color-text-secondary)]">Response
                                        </div>
                                        <div class="text-[11px] text-[var(--color-text-muted)]">(Current)</div>
                                        <div id="metricCurrent"
                                            class="text-lg font-bold text-[var(--color-text-primary)] font-mono underline decoration-[color-mix(in_srgb,var(--color-primary)_60%,transparent)] underline-offset-4">
                                            -</div>
                                    </div>
                                    <div class="p-2 space-y-1">
                                        <div class="text-xs font-semibold text-[var(--color-text-secondary)]">Avg.
                                            Response
                                        </div>
                                        <div class="text-[11px] text-[var(--color-text-muted)]">(24 hours)</div>
                                        <div id="metricAvg24h"
                                            class="text-lg font-bold text-[var(--color-text-primary)] font-mono">-</div>
                                    </div>
                                    <div class="p-2 space-y-1">
                                        <div class="text-xs font-semibold text-[var(--color-text-secondary)]">Uptime
                                        </div>
                                        <div class="text-[11px] text-[var(--color-text-muted)]">(24 hours)</div>
                                        <div id="metricUptime24h"
                                            class="text-lg font-bold text-[var(--color-primary)] font-mono">-</div>
                                    </div>
                                    <div class="p-2 space-y-1">
